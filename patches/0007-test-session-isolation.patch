+++ b/packages/coding-agent/test/config-dir-test-isolation.test.ts
@@ -0,0 +1,24 @@
+import { homedir, tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { describe, expect, test } from "vitest";
+import { CONFIG_DIR_NAME, getAgentDir } from "../src/config.ts";
+
+// Regression guard for test-suite session leakage. Before the setupFiles
+// redirect existed, every test process resolved getAgentDir() to the user's
+// real ~/.<configDir>/agent and wrote sessions / auth / settings there. This
+// test fails the moment that isolation is lost again, regardless of brand.
+describe("test config-dir isolation", () => {
+	test("getAgentDir never resolves to the user's real home config dir", () => {
+		const agentDir = getAgentDir();
+		const realHomeAgentDir = join(homedir(), CONFIG_DIR_NAME, "agent");
+		expect(agentDir).not.toBe(realHomeAgentDir);
+	});
+
+	test("home-relative discovery is redirected away from the real home", () => {
+		// setup-isolate-config-dir.ts points HOME at a throwaway temp dir so
+		// ~/.agents/skills and any other home-relative scan cannot leak real
+		// user resources into resource-resolution assertions.
+		if (process.env.PI_TEST_REAL_HOME) return; // explicit opt-out keeps the real home
+		expect(dirname(process.env.HOME ?? homedir())).toBe(tmpdir());
+	});
+});
diff --git a/packages/coding-agent/test/setup-isolate-config-dir.ts b/packages/coding-agent/test/setup-isolate-config-dir.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/test/setup-isolate-config-dir.ts
@@ -0,0 +1,21 @@
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { ENV_AGENT_DIR } from "../src/config.ts";
+
+// Tests must never read or write the user's real agent config dir
+// (~/.<configDir>/agent). Without this redirect, session / auth / settings /
+// models storage falls back to the user's home directory and leaks test
+// artifacts there. Point every test process at a throwaway temp dir instead.
+// Honors an externally supplied override so individual tests can opt out.
+if (!process.env[ENV_AGENT_DIR]) {
+	process.env[ENV_AGENT_DIR] = mkdtempSync(join(tmpdir(), "pi-test-config-"));
+}
+
+// Resource discovery also reads $HOME directly (for example ~/.agents/skills
+// in the package manager), so a developer machine with a populated home leaks
+// real skills into config-selector tests and shifts their assertions. Point
+// HOME at a throwaway temp dir too. Opt out with PI_TEST_REAL_HOME=1.
+if (!process.env.PI_TEST_REAL_HOME) {
+	process.env.HOME = mkdtempSync(join(tmpdir(), "pi-test-home-"));
+}
