new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/test/acp/tool-input-stream.test.ts
@@ -0,0 +1,81 @@
+import { describe, expect, it } from "vitest";
+import type { AgentSessionEvent } from "../../src/core/agent-session.ts";
+import { AcpToolInputStreams, clientWantsToolInputStream } from "../../src/modes/acp/tool-input-stream.ts";
+
+function toolEvent(type: "toolcall_start" | "toolcall_delta" | "toolcall_end", extra: Record<string, unknown> = {}): AgentSessionEvent {
+	const partial = {
+		role: "assistant",
+		content: [{ type: "toolCall", id: "call-1", name: "write", arguments: { path: "/tmp/a.txt", text: "already parsed" } }],
+		timestamp: 1,
+	};
+	return {
+		type: "message_update",
+		message: partial,
+		assistantMessageEvent: { type, contentIndex: 0, partial, ...extra },
+	} as AgentSessionEvent;
+}
+
+describe("ACP tool input stream", () => {
+	it("forwards raw deltas before execution and does not re-serialize the live partial", () => {
+		const streams = new AcpToolInputStreams("session-1", true);
+		const start = streams.ingest(toolEvent("toolcall_start"));
+		const delta = streams.ingest(toolEvent("toolcall_delta", { delta: "{\"text\":\"笔记\"}" }));
+		expect(start[0]?.params).toMatchObject({
+			version: 1,
+			sessionId: "session-1",
+			toolCallId: "call-1",
+			seq: 0,
+			event: { type: "start", toolName: "write" },
+		});
+		expect(start[0]?.params.event).not.toHaveProperty("initialArguments");
+		expect(start[0]?.params.event).toMatchObject({ initialInput: { text: "already parsed" } });
+		expect(delta[0]?.params).toMatchObject({
+			seq: 1,
+			event: { type: "delta", delta: "{\"text\":\"笔记\"}" },
+		});
+		expect(streams.ingest(toolEvent("toolcall_end"))[0]?.params.event).toEqual({ type: "end", status: "completed" });
+	});
+
+	it("ends an open stream when the prompt is cancelled", () => {
+		const streams = new AcpToolInputStreams("session-1", true);
+		streams.ingest(toolEvent("toolcall_start"));
+		expect(streams.closeAll("cancelled", "prompt cancelled")[0]?.params.event).toEqual({
+			type: "end",
+			status: "cancelled",
+			reason: "prompt cancelled",
+		});
+		expect(streams.ingest(toolEvent("toolcall_delta", { delta: "late" }))).toEqual([]);
+	});
+
+	it("stays silent unless the client advertised the capability", () => {
+		const streams = new AcpToolInputStreams("session-1", false);
+		expect(streams.ingest(toolEvent("toolcall_start"))).toEqual([]);
+		expect(clientWantsToolInputStream({ _meta: { lody: { toolInputStream: { version: 1 } } } })).toBe(true);
+		expect(clientWantsToolInputStream({ _meta: { lody: { subagentEvents: { version: 1 } } } })).toBe(false);
+	});
+});
+
+
+it("copies the start snapshot and keeps stream ids unique across prompts", () => {
+    const event = toolEvent("toolcall_start");
+    const first = new AcpToolInputStreams("session-1", true).ingest(event)[0]!;
+    const second = new AcpToolInputStreams("session-1", true).ingest(event)[0]!;
+    if (event.type === "message_update") {
+        const block = event.assistantMessageEvent.partial.content[0];
+        if (block.type === "toolCall") block.arguments.text = "later mutation";
+    }
+    expect(first.params.event).toMatchObject({ initialInput: { text: "already parsed" } });
+    expect(first.params.streamId).not.toBe(second.params.streamId);
+});
+
+it("splits Unicode without changing raw text and stops only the capped stream", () => {
+    const streams = new AcpToolInputStreams("s", true);
+    streams.ingest(toolEvent("toolcall_start"));
+    const text = "中🌱".repeat(20000) + "\ud83c" + "x".repeat(65536);
+    const deltas = streams.ingest(toolEvent("toolcall_delta", {delta: text}));
+    expect(deltas.map(e => e.params.event.type === "delta" ? e.params.event.delta : "").join("")).toBe(text);
+    expect(deltas.every(e => e.params.event.type === "delta" && Buffer.byteLength(e.params.event.delta) <= 65536)).toBe(true);
+    const capped = streams.ingest(toolEvent("toolcall_delta", {delta: "x".repeat(1024 * 1024)}));
+    expect(capped.at(-1)?.params.event).toMatchObject({type: "end", status: "incomplete"});
+    expect(streams.ingest(toolEvent("toolcall_delta", {delta: "late"}))).toEqual([]);
+});
