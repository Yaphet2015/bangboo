diff --git a/packages/coding-agent/src/modes/acp/tool-input-stream.ts b/packages/coding-agent/src/modes/acp/tool-input-stream.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/modes/acp/tool-input-stream.ts
@@ -0,0 +1,152 @@
+import { randomUUID } from "node:crypto";
+import type { AgentSessionEvent } from "../../core/agent-session.ts";
+
+const METHOD = "_lody/session/tool_input";
+const MAX_STREAM_BYTES = 1024 * 1024;
+const MAX_DELTA_BYTES = 64 * 1024;
+const MAX_OPEN = 32;
+
+type EndStatus = "completed" | "cancelled" | "failed" | "incomplete";
+
+export interface ToolInputNotification {
+	method: typeof METHOD;
+	params: {
+		version: 1;
+		sessionId: string;
+		toolCallId: string;
+		streamId: string;
+		seq: number;
+		event:
+			| { type: "start"; toolName?: string; initialInput?: Record<string, unknown> }
+			| { type: "delta"; delta: string }
+			| { type: "end"; status: EndStatus; reason?: string };
+	};
+}
+
+interface OpenStream {
+	streamId: string;
+	seq: number;
+	bytes: number;
+}
+
+/**
+ * Forwards Bangboo `toolcall_start` / `toolcall_delta` / `toolcall_end` as Core
+ * tool-input events. Deltas are the provider's raw fragments. A parsed partial
+ * is never re-serialized into a fake fragment.
+ */
+export class AcpToolInputStreams {
+	private readonly open = new Map<string, OpenStream>();
+
+	private readonly sessionId: string;
+	private readonly enabled: boolean;
+
+	constructor(sessionId: string, enabled: boolean) {
+		this.sessionId = sessionId;
+		this.enabled = enabled;
+	}
+
+	ingest(event: AgentSessionEvent): ToolInputNotification[] {
+		if (!this.enabled || event.type !== "message_update") return [];
+		const update = event.assistantMessageEvent;
+		if (update.type !== "toolcall_start" && update.type !== "toolcall_delta" && update.type !== "toolcall_end") {
+			return [];
+		}
+		const block = update.partial.content[update.contentIndex];
+		if (!block || block.type !== "toolCall" || !block.id) return [];
+		if (update.type === "toolcall_start") return this.start(block.id, block.name, structuredClone(block.arguments));
+		if (update.type === "toolcall_delta") return this.delta(block.id, update.delta);
+		return this.finish(block.id, "completed");
+	}
+
+	closeAll(status: Exclude<EndStatus, "completed">, reason: string): ToolInputNotification[] {
+		return [...this.open.keys()].flatMap((toolCallId) => this.finish(toolCallId, status, reason));
+	}
+
+	private start(toolCallId: string, toolName: string, initialInput: Record<string, unknown>): ToolInputNotification[] {
+		const ended = this.open.has(toolCallId) ? this.finish(toolCallId, "incomplete", "tool input restarted") : [];
+		const bytes = Buffer.byteLength(JSON.stringify(initialInput), "utf8");
+		const overLimit = bytes > MAX_STREAM_BYTES || this.open.size >= MAX_OPEN;
+		const stream: OpenStream = { streamId: `tis-${randomUUID()}`, seq: 0, bytes };
+		const start = this.emit(toolCallId, stream, { type: "start", ...(toolName ? { toolName } : {}), ...(!overLimit ? { initialInput } : {}) });
+		if (overLimit) {
+			return [...ended, start, this.emit(toolCallId, stream, {
+				type: "end",
+				status: "incomplete",
+				reason: "tool input capacity exceeded",
+			})];
+		}
+		this.open.set(toolCallId, stream);
+		return [...ended, start];
+	}
+
+	private delta(toolCallId: string, delta: string): ToolInputNotification[] {
+		const stream = this.open.get(toolCallId);
+		if (!stream) return [];
+		const events: ToolInputNotification[] = [];
+		for (const piece of splitUtf8(delta, MAX_DELTA_BYTES)) {
+			const pieceBytes = Buffer.byteLength(piece, "utf8");
+			if (stream.bytes + pieceBytes > MAX_STREAM_BYTES) {
+				return [...events, ...this.finish(toolCallId, "incomplete", "tool input exceeded 1 MiB")];
+			}
+			stream.bytes += pieceBytes;
+			events.push(this.emit(toolCallId, stream, { type: "delta", delta: piece }));
+		}
+		return events;
+	}
+
+	private finish(toolCallId: string, status: EndStatus, reason?: string): ToolInputNotification[] {
+		const stream = this.open.get(toolCallId);
+		if (!stream) return [];
+		this.open.delete(toolCallId);
+		return [this.emit(toolCallId, stream, { type: "end", status, ...(reason ? { reason } : {}) })];
+	}
+
+	private emit(
+		toolCallId: string,
+		stream: OpenStream,
+		event: ToolInputNotification["params"]["event"],
+	): ToolInputNotification {
+		return {
+			method: METHOD,
+			params: {
+				version: 1,
+				sessionId: this.sessionId,
+				toolCallId,
+				streamId: stream.streamId,
+				seq: stream.seq++,
+				event,
+			},
+		};
+	}
+}
+
+function splitUtf8(text: string, maxBytes: number): string[] {
+	if (Buffer.byteLength(text, "utf8") <= maxBytes) return [text];
+	const parts: string[] = [];
+	let start = 0;
+	let index = 0;
+	let bytes = 0;
+	for (const point of text) {
+		const size = Buffer.byteLength(point, "utf8");
+		if (bytes + size > maxBytes) {
+			parts.push(text.slice(start, index));
+			start = index;
+			bytes = 0;
+		}
+		bytes += size;
+		index += point.length;
+	}
+	parts.push(text.slice(start));
+	return parts;
+}
+
+export function clientWantsToolInputStream(capabilities: unknown): boolean {
+	if (!capabilities || typeof capabilities !== "object") return false;
+	const meta = (capabilities as { _meta?: unknown })._meta;
+	if (!meta || typeof meta !== "object") return false;
+	const lody = (meta as { lody?: unknown }).lody;
+	if (!lody || typeof lody !== "object") return false;
+	const toolInputStream = (lody as { toolInputStream?: unknown }).toolInputStream;
+	return !!toolInputStream && typeof toolInputStream === "object"
+		&& (toolInputStream as { version?: unknown }).version === 1;
+}
