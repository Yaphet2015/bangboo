+// Compatibility entry for the @earendil-works/pi-coding-agent alias. The real
+// host API lives in ../../../dist/index.js; re-exporting it keeps module
+// identity intact while placing this entry one level below pi-compat's
+// manifest so extensions that sniff `dirname(resolved)/../package.json` see
+// the mirrored runtime version instead of Bangboo's own package version.
+export * from "../../../dist/index.js";
