+import { describe, expect, it } from "vitest";
+import { toBangbooPrompt } from "../../src/modes/acp/content.ts";
+
+describe("ACP prompt conversion", () => {
+	it("joins text and converts base64 images", () => {
+		expect(toBangbooPrompt([{ type: "text", text: "one" }, { type: "text", text: "two" }, { type: "image", data: "YWJj", mimeType: "image/png" }], true)).toEqual({
+			text: "one\n\ntwo",
+			images: [{ type: "image", data: "YWJj", mimeType: "image/png" }],
+		});
+	});
+	it("rejects every unsupported prompt block with invalid params", () => {
+		const unsupported = [
+			[{ type: "audio", data: "YWJj", mimeType: "audio/wav" }],
+			[{ type: "image", data: "YWJj", mimeType: "image/png" }],
+			[{ type: "resource_link", name: "x", uri: "file:///x" }],
+			[{ type: "resource", resource: { uri: "file:///x", text: "x" } }],
+		] as const;
+		for (const [index, prompt] of unsupported.entries()) {
+			try {
+				toBangbooPrompt(prompt as never, index !== 1);
+				expect.fail("expected invalid params");
+			} catch (error) {
+				expect(error).toMatchObject({ code: -32602 });
+			}
+		}
+	});
+});
