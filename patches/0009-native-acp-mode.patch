+describe("Bangboo ACP persisted session lookup", () => {
+	const originalCwd = process.cwd();
+	const originalAgentDir = process.env[ENV_AGENT_DIR];
+	const tempDirs: string[] = [];
+
+	afterEach(() => {
+		process.chdir(originalCwd);
+		if (originalAgentDir === undefined) delete process.env[ENV_AGENT_DIR];
+		else process.env[ENV_AGENT_DIR] = originalAgentDir;
+		for (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+	});
+
+	it("uses real SessionManager list/open for exact-ID, unknown, and cross-cwd lookup", async () => {
+		const root = mkdtempSync(join(tmpdir(), "bangboo-acp-session-"));
+		tempDirs.push(root);
+		const project = join(root, "project");
+		const otherProject = join(root, "other-project");
+		mkdirSync(project);
+		mkdirSync(otherProject);
+		process.chdir(root);
+		process.env[ENV_AGENT_DIR] = join(root, "agent");
+
+		const exact = persistSession(project, "exact-session");
+		const exactPath = exact.getSessionFile();
+		persistSession(otherProject, "cross-cwd-session", getDefaultSessionDir(project));
+		const openedPaths: (string | undefined)[] = [];
+		const createRuntime = vi.fn(async (_cwd: string, manager: SessionManager) => {
+			openedPaths.push(manager.getSessionFile());
+			return createHostedSession(manager.getSessionId());
+		});
+		const host = createBangbooSessionHost({
+			client: {} as acp.AgentContext,
+			extensionFactories: [],
+			dependencies: { createRuntime },
+		});
+
+		await host.loadSession({ cwd: project, sessionId: "exact-session", mcpServers: [] });
+		expect(openedPaths).toEqual([exactPath]);
+		await expectInvalid(host.loadSession({ cwd: project, sessionId: "missing", mcpServers: [] }));
+		await expectInvalid(host.loadSession({ cwd: project, sessionId: "cross-cwd-session", mcpServers: [] }));
+		expect(createRuntime).toHaveBeenCalledTimes(1);
+	});
+});
