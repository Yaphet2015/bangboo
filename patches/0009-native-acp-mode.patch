@@ -0,0 +1,38 @@
+import * as acp from "@agentclientprotocol/sdk";
+import { describe, expect, it, vi } from "vitest";
+import { mapAgentSessionEvent, replaySessionHistory } from "../../src/modes/acp/event-mapper.ts";
+
+describe("ACP event mapping", () => {
+	it("maps tool lifecycle with stable IDs and exact kinds", () => {
+		expect(mapAgentSessionEvent({ type: "tool_execution_start", toolCallId: "c1", toolName: "bash", args: { command: "pwd" } })).toEqual([
+			{ sessionUpdate: "tool_call", toolCallId: "c1", kind: "execute", status: "in_progress", rawInput: { command: "pwd" }, title: "bash" },
+		]);
+		expect(mapAgentSessionEvent({ type: "tool_execution_end", toolCallId: "c1", toolName: "bash", result: { content: [{ type: "text", text: "bad" }] }, isError: true })).toMatchObject([
+			{ sessionUpdate: "tool_call_update", toolCallId: "c1", status: "failed" },
+		]);
+	});
+	it("maps text and thinking deltas separately", () => {
+		const base = { role: "assistant", content: [], usage: {}, stopReason: "pending", timestamp: 0 } as never;
+		expect(mapAgentSessionEvent({ type: "message_update", message: base, assistantMessageEvent: { type: "text_delta", delta: "a" } as never })[0]).toMatchObject({ sessionUpdate: "agent_message_chunk", content: { text: "a" } });
+		expect(mapAgentSessionEvent({ type: "message_update", message: base, assistantMessageEvent: { type: "thinking_delta", delta: "b" } as never })[0]).toMatchObject({ sessionUpdate: "agent_thought_chunk", content: { text: "b" } });
+	});
+	it("replays stored messages and tool results in order with stable IDs", async () => {
+		const notify = vi.fn(async () => {});
+		await replaySessionHistory("s1", [
+			{ role: "user", content: "hi", timestamp: 1 },
+			{ role: "assistant", content: [
+				{ type: "thinking", thinking: "consider" },
+				{ type: "text", text: "hello" },
+				{ type: "toolCall", id: "c1", name: "read", arguments: { path: "/x" } },
+			] },
+			{ role: "toolResult", toolCallId: "c1", toolName: "read", content: [{ type: "text", text: "data" }], isError: false },
+		] as never, { notify } as unknown as acp.AgentContext);
+		expect(notify.mock.calls.map((call) => call[1].update)).toMatchObject([
+			{ sessionUpdate: "user_message_chunk", messageId: "s1:history:0" },
+			{ sessionUpdate: "agent_thought_chunk", messageId: "s1:history:1:thinking:0", content: { text: "consider" } },
+			{ sessionUpdate: "agent_message_chunk", messageId: "s1:history:1", content: { text: "hello" } },
+			{ sessionUpdate: "tool_call", toolCallId: "c1", rawInput: { path: "/x" } },
+			{ sessionUpdate: "tool_call_update", toolCallId: "c1", status: "completed" },
+		]);
+	});
+});
diff --git a/packages/coding-agent/test/acp/permission-gate.test.ts b/packages/coding-agent/test/acp/permission-gate.test.ts
new file mode 100644
index 00000000..522d9b4b
--- /dev/null
+++ b/packages/coding-agent/test/acp/permission-gate.test.ts
@@ -0,0 +1,110 @@
+import * as acp from "@agentclientprotocol/sdk";
+import { describe, expect, it, vi } from "vitest";
+import type { ExtensionAPI, ToolCallEvent, ToolCallEventResult } from "../../src/core/extensions/types.ts";
+import {
+	createAcpClientPermissionBroker,
+	createAcpPermissionExtension,
+} from "../../src/modes/acp/permission-gate.ts";
+
+function event(toolName: string, input: Record<string, unknown> = {}): ToolCallEvent {
+	return { type: "tool_call", toolCallId: `call-${toolName}`, toolName, input } as ToolCallEvent;
+}
+
+function harness(request: ReturnType<typeof vi.fn>, signal = new AbortController().signal) {
+	let handler!: (event: ToolCallEvent) => Promise<ToolCallEventResult | undefined>;
+	const broker = createAcpClientPermissionBroker({
+		client: { request, signal } as unknown as acp.AgentContext,
+		sessionId: "session-1",
+		sessionApprovals: new Set<string>(),
+	});
+	createAcpPermissionExtension(broker)({
+		on: vi.fn((_name, next) => { handler = next; }),
+	} as unknown as ExtensionAPI);
+	return { broker, handler };
+}
+
+describe("ACP permission gate", () => {
+	it.each(["read", "grep", "find", "ls"])("allows read-only %s without asking", async (toolName) => {
+		const request = vi.fn();
+		const { handler } = harness(request);
+		await expect(handler(event(toolName))).resolves.toBeUndefined();
+		expect(request).not.toHaveBeenCalled();
+	});
+
+	it.each([
+		["edit", "edit"], ["write", "edit"], ["bash", "execute"], ["extension", "other"],
+	])("requests permission for %s with ACP tool details", async (toolName, kind) => {
+		const request = vi.fn(async () => ({ outcome: { outcome: "selected", optionId: "allow_once" } }));
+		const { handler } = harness(request);
+		const input = toolName === "bash" ? { command: "echo safe" } : { path: "/tmp/file" };
+		await expect(handler(event(toolName, input))).resolves.toBeUndefined();
+		expect(request).toHaveBeenCalledWith(acp.methods.client.session.requestPermission, {
+			sessionId: "session-1",
+			toolCall: { toolCallId: `call-${toolName}`, title: toolName, kind, rawInput: input },
+			options: [
+				{ optionId: "allow_once", name: "Allow once", kind: "allow_once" },
+				{ optionId: "allow_session", name: "Allow for this session", kind: "allow_always" },
+				{ optionId: "deny", name: "Deny", kind: "reject_once" },
+			],
+		});
+	});
+
+	it("caches only allow-session by tool name", async () => {
+		const request = vi.fn()
+			.mockResolvedValueOnce({ outcome: { outcome: "selected", optionId: "allow_once" } })
+			.mockResolvedValueOnce({ outcome: { outcome: "selected", optionId: "allow_session" } });
+		const { handler } = harness(request);
+		await handler(event("bash"));
+		await handler(event("bash"));
+		await handler(event("bash"));
+		expect(request).toHaveBeenCalledTimes(2);
+	});
+
+	it.each([
+		["deny", { outcome: { outcome: "selected", optionId: "deny" } }],
+		["cancelled", { outcome: { outcome: "cancelled" } }],
+		["malformed", { outcome: { outcome: "selected", optionId: "unexpected" } }],
+	])("fails closed for %s responses", async (_label, response) => {
+		const { handler } = harness(vi.fn(async () => response));
+		await expect(handler(event("write"))).resolves.toEqual({ block: true, reason: "Tool execution denied by ACP client" });
+	});
+
+	it("fails closed when the request throws or the client disconnects", async () => {
+		const thrown = harness(vi.fn(async () => { throw new Error("disconnected"); }));
+		await expect(thrown.handler(event("edit"))).resolves.toMatchObject({ block: true });
+		const controller = new AbortController();
+		controller.abort();
+		const disconnected = harness(vi.fn(() => new Promise(() => {})), controller.signal);
+		await expect(disconnected.handler(event("edit"))).resolves.toMatchObject({ block: true });
+	});
+
+	it("cancelling pending requests settles all gates as denied", async () => {
+		const { broker, handler } = harness(vi.fn(() => new Promise(() => {})));
+		const pending = [handler(event("edit")), handler(event("bash"))];
+		broker.cancelPending();
+		await expect(Promise.all(pending)).resolves.toEqual([
+			{ block: true, reason: "Tool execution denied by ACP client" },
+			{ block: true, reason: "Tool execution denied by ACP client" },
+		]);
+	});
+
+	it("does not cache a late allow-session response after cancellation", async () => {
+		let resolveRequest!: (response: unknown) => void;
+		const request = vi.fn()
+			.mockImplementationOnce(() => new Promise((resolve) => { resolveRequest = resolve; }))
+			.mockResolvedValueOnce({ outcome: { outcome: "selected", optionId: "deny" } });
+		const { broker, handler } = harness(request);
+		const first = handler(event("bash"));
+
+		await vi.waitFor(() => expect(request).toHaveBeenCalledTimes(1));
+		broker.cancelPending();
+		resolveRequest({ outcome: { outcome: "selected", optionId: "allow_session" } });
+
+		await expect(first).resolves.toEqual({ block: true, reason: "Tool execution denied by ACP client" });
+		await expect(handler(event("bash"))).resolves.toEqual({
+			block: true,
+			reason: "Tool execution denied by ACP client",
+		});
+		expect(request).toHaveBeenCalledTimes(2);
+	});
+});
