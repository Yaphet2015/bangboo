@@ -0,0 +1,61 @@
+import * as acp from "@agentclientprotocol/sdk";
+import { describe, expect, it, vi } from "vitest";
+import { main } from "../../src/main.ts";
+import { createAcpAgentApp, runAcpAgentApp } from "../../src/modes/acp/acp-mode.ts";
+import type { AcpSessionHost } from "../../src/modes/acp/session-host.ts";
+
+describe("ACP mode", () => {
+	it("advertises session loading after lifecycle handlers are registered", async () => {
+		const initialize = await acp.client({ name: "test-client" }).connectWith(
+			createAcpAgentApp({ version: "0.1.1" }),
+			(client) =>
+				client.request(acp.methods.agent.initialize, {
+					protocolVersion: acp.PROTOCOL_VERSION,
+					clientCapabilities: {},
+				}),
+		);
+
+		expect(initialize.protocolVersion).toBe(acp.PROTOCOL_VERSION);
+		expect(initialize.agentInfo).toMatchObject({ name: "bangboo", version: "0.1.1" });
+		expect(initialize.agentCapabilities).toEqual({ loadSession: true, promptCapabilities: { image: true } });
+	});
+
+	it("disposes an injected host exactly once when the connection closes", async () => {
+		const dispose = vi.fn(async () => {});
+		const host = {
+			newSession: vi.fn(async () => ({ sessionId: "session-1", configOptions: [] })),
+			loadSession: vi.fn(async () => ({ configOptions: [] })),
+			setConfigOption: vi.fn(async () => ({ configOptions: [] })),
+			prompt: vi.fn(async () => ({ stopReason: "end_turn" as const })),
+			cancel: vi.fn(async () => {}),
+			dispose,
+		} satisfies AcpSessionHost;
+
+		await runAcpAgentApp(
+			(app) =>
+				acp.client({ name: "test-client" }).connectWith(app, (agent) =>
+					agent.request(acp.methods.agent.session.new, { cwd: "/tmp/project", mcpServers: [] }),
+				),
+			{ hostFactory: () => host },
+		);
+
+		expect(dispose).toHaveBeenCalledTimes(1);
+	});
+
+	it("prints ACP help before normal interactive startup", async () => {
+		const stderr = vi.spyOn(process.stderr, "write").mockImplementation(() => true);
+		const previousExitCode = process.exitCode;
+
+		const acpRunner = vi.fn();
+
+		try {
+			await main(["acp", "--help"], { acpRunner });
+			expect(stderr).toHaveBeenCalledWith("Usage: bangboo acp\nACP v1 over stdin/stdout.\n");
+			expect(acpRunner).not.toHaveBeenCalled();
+			expect(process.exitCode).toBe(previousExitCode);
+		} finally {
+			stderr.mockRestore();
+			process.exitCode = previousExitCode;
+		}
+	});
+});
