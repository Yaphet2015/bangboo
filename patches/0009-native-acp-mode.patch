@@ -0,0 +1,371 @@
+import { mkdtempSync, mkdirSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import * as acp from "@agentclientprotocol/sdk";
+import type { Model } from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { createAcpAgentApp } from "../../src/modes/acp/acp-mode.ts";
+import {
+	createBangbooSessionHost,
+	type AcpSessionHost,
+	type AcpSessionHostDependencies,
+	type HostedSession,
+} from "../../src/modes/acp/session-host.ts";
+import { getDefaultSessionDir, SessionManager } from "../../src/core/session-manager.ts";
+import { ENV_AGENT_DIR } from "../../src/config.ts";
+
+function fakeHost(): AcpSessionHost {
+	return {
+		newSession: vi.fn(async () => ({ sessionId: "session-1", configOptions: [] })),
+		loadSession: vi.fn(async () => ({ configOptions: [] })),
+		setConfigOption: vi.fn(async () => ({ configOptions: [] })),
+		prompt: vi.fn(async () => ({ stopReason: "end_turn" })),
+		cancel: vi.fn(async () => {}),
+		dispose: vi.fn(async () => {}),
+	};
+}
+
+const models = [
+	{ provider: "zai-coding-cn", id: "glm-5", name: "GLM-5", reasoning: true },
+	{ provider: "anthropic", id: "claude-sonnet", name: "Claude Sonnet", reasoning: true },
+] as Model<any>[];
+
+function createHostedSession(id = "session-1"): HostedSession & {
+	abort: ReturnType<typeof vi.fn>;
+	flush: ReturnType<typeof vi.fn>;
+	dispose: ReturnType<typeof vi.fn>;
+	setModel: ReturnType<typeof vi.fn>;
+	setThinkingLevel: ReturnType<typeof vi.fn>;
+} {
+	const abort = vi.fn(async () => {});
+	const flush = vi.fn(async () => {});
+	const dispose = vi.fn();
+	const setModel = vi.fn(async (model: Model<any>) => {
+		session.model = model;
+	});
+	const setThinkingLevel = vi.fn((level: string) => {
+		session.thinkingLevel = level;
+	});
+	const session = {
+		model: models[0],
+		thinkingLevel: "high",
+		getAvailableThinkingLevels: vi.fn(() => ["off", "low", "high"]),
+		setModel,
+		setThinkingLevel,
+		abort,
+		dispose,
+		sessionManager: { getSessionId: () => id },
+	};
+	return {
+		session: session as never,
+		services: {
+			modelRuntime: { getAvailable: vi.fn(async () => models) },
+			settingsManager: { flush },
+		} as never,
+		abort,
+		flush,
+		dispose,
+		setModel,
+		setThinkingLevel,
+	};
+}
+
+function createPolicyHarness(options: { listedCwd?: string; listedId?: string; runtimeIds?: string[] } = {}) {
+	const hosted: ReturnType<typeof createHostedSession>[] = [];
+	let runtimeIndex = 0;
+	let managerIndex = 0;
+	const createRuntime = vi.fn(async () => {
+		const session = createHostedSession(options.runtimeIds?.[runtimeIndex++] ?? "session-1");
+		hosted.push(session);
+		return session;
+	});
+	const dependencies: AcpSessionHostDependencies = {
+		createRuntime,
+		createSessionManager: vi.fn(
+			() =>
+				({
+					getSessionId: () => options.runtimeIds?.[managerIndex++] ?? "session-1",
+				}) as SessionManager,
+		),
+		openSessionManager: vi.fn(() => ({}) as SessionManager),
+		listSessions: vi.fn(async () =>
+			options.listedId
+				? [
+						{
+							id: options.listedId,
+							cwd: options.listedCwd ?? "/tmp/project",
+							path: "/sessions/session.jsonl",
+							created: new Date(),
+							modified: new Date(),
+							messageCount: 0,
+							firstMessage: "",
+							allMessagesText: "",
+						},
+					]
+				: [],
+		),
+	};
+	const host = createBangbooSessionHost({
+		client: {} as acp.AgentContext,
+		extensionFactories: [],
+		dependencies,
+	});
+	return { host, dependencies, createRuntime, hosted };
+}
+
+async function expectInvalid(promise: Promise<unknown>): Promise<void> {
+	await expect(promise).rejects.toMatchObject({ code: -32602 });
+}
+
+function persistSession(cwd: string, id: string, sessionDir?: string): SessionManager {
+	const manager = SessionManager.create(cwd, sessionDir, { id });
+	manager.appendMessage({ role: "user", content: "persist me", timestamp: Date.now() });
+	manager.appendMessage({
+		role: "assistant",
+		content: [{ type: "text", text: "persisted" }],
+		api: "anthropic-messages",
+		provider: "anthropic",
+		model: "test",
+		usage: {
+			input: 1,
+			output: 1,
+			cacheRead: 0,
+			cacheWrite: 0,
+			totalTokens: 2,
+			cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+		},
+		stopReason: "stop",
+		timestamp: Date.now(),
+	});
+	return manager;
+}
