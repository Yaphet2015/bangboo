+describe("Bangboo ACP session host policy", () => {
+	it("rejects relative cwd, MCP servers, and additional roots before runtime creation", async () => {
+		const { host, createRuntime } = createPolicyHarness();
+		await expectInvalid(host.newSession({ cwd: "relative", mcpServers: [] }));
+		await expectInvalid(
+			host.newSession({
+				cwd: "/tmp/project",
+				mcpServers: [{ name: "server", command: "/bin/true", args: [], env: [] }],
+			}),
+		);
+		await expectInvalid(
+			host.newSession({ cwd: "/tmp/project", mcpServers: [], additionalDirectories: ["/tmp/other"] }),
+		);
+		expect(createRuntime).not.toHaveBeenCalled();
+	});
+
+	it("rejects unknown IDs and sessions belonging to another cwd", async () => {
+		const unknown = createPolicyHarness();
+		await expectInvalid(
+			unknown.host.loadSession({ cwd: "/tmp/project", sessionId: "missing", mcpServers: [] }),
+		);
+		const crossCwd = createPolicyHarness({ listedId: "session-1", listedCwd: "/tmp/other" });
+		await expectInvalid(
+			crossCwd.host.loadSession({ cwd: "/tmp/project", sessionId: "session-1", mcpServers: [] }),
+		);
+		expect(crossCwd.createRuntime).not.toHaveBeenCalled();
+	});
+
+	it("returns and refreshes standard model and thinking configuration", async () => {
+		const { host, hosted } = createPolicyHarness();
+		const created = await host.newSession({ cwd: "/tmp/project", mcpServers: [] });
+		expect(created.configOptions?.find((option) => option.category === "model")?.currentValue).toBe(
+			"zai-coding-cn/glm-5",
+		);
+		expect(created.configOptions?.find((option) => option.category === "thought_level")?.currentValue).toBe("high");
+
+		const changedModel = await host.setConfigOption({
+			sessionId: "session-1",
+			configId: "model",
+			value: "anthropic/claude-sonnet",
+		});
+		expect(hosted[0].setModel).toHaveBeenCalledWith(models[1]);
+		expect(changedModel.configOptions.find((option) => option.category === "model")?.currentValue).toBe(
+			"anthropic/claude-sonnet",
+		);
+
+		const changedThinking = await host.setConfigOption({
+			sessionId: "session-1",
+			configId: "thought_level",
+			value: "low",
+		});
+		expect(changedThinking.configOptions.find((option) => option.category === "thought_level")?.currentValue).toBe(
+			"low",
+		);
+		await expectInvalid(
+			host.setConfigOption({ sessionId: "session-1", configId: "thought_level", value: "extreme" }),
+		);
+		expect(hosted[0].setThinkingLevel).toHaveBeenCalledTimes(1);
+	});
+
+	it("atomically rejects concurrent duplicate creation without replacing or leaking a runtime", async () => {
+		const hosted = createHostedSession("session-1");
+		let releaseRuntime!: () => void;
+		const runtimeGate = new Promise<void>((resolve) => {
+			releaseRuntime = resolve;
+		});
+		const createRuntime = vi.fn(async () => {
+			await runtimeGate;
+			return hosted;
+		});
+		const sessionManager = { getSessionId: () => "session-1" } as SessionManager;
+		const host = createBangbooSessionHost({
+			client: {} as acp.AgentContext,
+			extensionFactories: [],
+			dependencies: {
+				createRuntime,
+				createSessionManager: () => sessionManager,
+			},
+		});
+
+		const first = host.newSession({ cwd: "/tmp/project", mcpServers: [] });
+		await vi.waitFor(() => expect(createRuntime).toHaveBeenCalledTimes(1));
+		await expectInvalid(host.newSession({ cwd: "/tmp/project", mcpServers: [] }));
+		releaseRuntime();
+		await first;
+		expect(createRuntime).toHaveBeenCalledTimes(1);
+		expect(hosted.abort).not.toHaveBeenCalled();
+		expect(hosted.flush).not.toHaveBeenCalled();
+		expect(hosted.dispose).not.toHaveBeenCalled();
+		await host.cancel({ sessionId: "session-1" });
+		expect(hosted.abort).toHaveBeenCalledTimes(1);
+	});
+
+	it("atomically rejects concurrent duplicate loads before opening another runtime", async () => {
+		const hosted = createHostedSession("session-1");
+		let releaseList!: () => void;
+		const listGate = new Promise<void>((resolve) => {
+			releaseList = resolve;
+		});
+		const listSessions = vi.fn(async () => {
+			await listGate;
+			return [
+				{
+					id: "session-1",
+					cwd: "/tmp/project",
+					path: "/sessions/session.jsonl",
+					created: new Date(),
+					modified: new Date(),
+					messageCount: 0,
+					firstMessage: "",
+					allMessagesText: "",
+				},
+			];
+		});
+		const createRuntime = vi.fn(async () => hosted);
+		const host = createBangbooSessionHost({
+			client: {} as acp.AgentContext,
+			extensionFactories: [],
+			dependencies: {
+				listSessions,
+				openSessionManager: () => ({}) as SessionManager,
+				createRuntime,
+			},
+		});
+
+		const params = { cwd: "/tmp/project", sessionId: "session-1", mcpServers: [] };
+		const first = host.loadSession(params);
+		await vi.waitFor(() => expect(listSessions).toHaveBeenCalledTimes(1));
+		await expectInvalid(host.loadSession(params));
+		releaseList();
+		await first;
+		expect(listSessions).toHaveBeenCalledTimes(1);
+		expect(createRuntime).toHaveBeenCalledTimes(1);
+		expect(hosted.dispose).not.toHaveBeenCalled();
+	});
+
+	it("rejects loading an already-hosted ID before opening another runtime", async () => {
+		const { host, createRuntime } = createPolicyHarness({ listedId: "session-1" });
+		await host.newSession({ cwd: "/tmp/project", mcpServers: [] });
+		await expectInvalid(
+			host.loadSession({ cwd: "/tmp/project", sessionId: "session-1", mcpServers: [] }),
+		);
+		expect(createRuntime).toHaveBeenCalledTimes(1);
+	});
+
+	it("aborts, flushes, and disposes each runtime exactly once across repeated disposal", async () => {
+		const { host, hosted } = createPolicyHarness();
+		await host.newSession({ cwd: "/tmp/project", mcpServers: [] });
+		await host.dispose();
+		await host.dispose();
+		expect(hosted[0].abort).toHaveBeenCalledTimes(1);
+		expect(hosted[0].flush).toHaveBeenCalledTimes(1);
+		expect(hosted[0].dispose).toHaveBeenCalledTimes(1);
+		expect(hosted[0].abort.mock.invocationCallOrder[0]).toBeLessThan(hosted[0].flush.mock.invocationCallOrder[0]);
+		expect(hosted[0].flush.mock.invocationCallOrder[0]).toBeLessThan(hosted[0].dispose.mock.invocationCallOrder[0]);
+	});
+});
