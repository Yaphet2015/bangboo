diff --git a/packages/coding-agent/src/modes/acp/acp-mode.ts b/packages/coding-agent/src/modes/acp/acp-mode.ts
new file mode 100644
index 00000000..8d8ac89a
--- /dev/null
+++ b/packages/coding-agent/src/modes/acp/acp-mode.ts
@@ -0,0 +1,52 @@
+import { Readable, Writable } from "node:stream";
+import * as acp from "@agentclientprotocol/sdk";
+import { builtInExtensions } from "../../extensions/index.ts";
+import { APP_NAME, VERSION } from "../../config.ts";
+import { createBangbooSessionHost, type AcpSessionHost } from "./session-host.ts";
+
+export interface AcpModeOptions {
+	version?: string;
+	hostFactory?: (client: acp.AgentContext) => AcpSessionHost;
+}
+
+export function createAcpAgentApp(options: AcpModeOptions = {}): acp.AgentApp {
+	let host: AcpSessionHost | undefined;
+	const getHost = (client: acp.AgentContext): AcpSessionHost => {
+		host ??= options.hostFactory?.(client) ?? createBangbooSessionHost({ client, extensionFactories: builtInExtensions });
+		return host;
+	};
+	return acp
+		.agent({ name: APP_NAME })
+		.onRequest(acp.methods.agent.initialize, () => ({
+			protocolVersion: acp.PROTOCOL_VERSION,
+			agentInfo: { name: APP_NAME, version: options.version ?? VERSION },
+			agentCapabilities: { loadSession: true },
+		}))
+		.onRequest(acp.methods.agent.session.new, ({ params, client }) => getHost(client).newSession(params))
+		.onRequest(acp.methods.agent.session.load, ({ params, client }) => getHost(client).loadSession(params))
+		.onRequest(acp.methods.agent.session.setConfigOption, ({ params, client }) =>
+			getHost(client).setConfigOption(params),
+		)
+		.onRequest(acp.methods.agent.session.prompt, ({ params, client }) => getHost(client).prompt(params))
+		.onNotification(acp.methods.agent.session.cancel, ({ params, client }) => getHost(client).cancel(params));
+}
+
+export async function runAcpMode(options: AcpModeOptions = {}): Promise<void> {
+	const stream = acp.ndJsonStream(
+		Writable.toWeb(process.stdout),
+		Readable.toWeb(process.stdin) as ReadableStream<Uint8Array>,
+	);
+	let host: AcpSessionHost | undefined;
+	const hostFactory =
+		options.hostFactory ??
+		((client: acp.AgentContext) => {
+			host ??= createBangbooSessionHost({ client, extensionFactories: builtInExtensions });
+			return host;
+		});
+	const connection = createAcpAgentApp({ ...options, hostFactory }).connect(stream);
+	try {
+		await connection.closed;
+	} finally {
+		await host?.dispose();
+	}
+}
diff --git a/packages/coding-agent/src/modes/acp/session-host.ts b/packages/coding-agent/src/modes/acp/session-host.ts
new file mode 100644
index 00000000..ac34099d
--- /dev/null
+++ b/packages/coding-agent/src/modes/acp/session-host.ts
@@ -0,0 +1,178 @@
+import { isAbsolute, normalize, resolve } from "node:path";
+import type { ThinkingLevel } from "@earendil-works/pi-agent-core";
+import type { Model } from "@earendil-works/pi-ai";
+import * as acp from "@agentclientprotocol/sdk";
+import { getAgentDir } from "../../config.ts";
+import {
+	createAgentSessionFromServices,
+	createAgentSessionServices,
+	type AgentSessionServices,
+} from "../../core/agent-session-services.ts";
+import type { AgentSession } from "../../core/agent-session.ts";
+import type { InlineExtension } from "../../core/extensions/types.ts";
+import { SessionManager } from "../../core/session-manager.ts";
+import { SettingsManager } from "../../core/settings-manager.ts";
+import { ProjectTrustStore } from "../../core/trust-manager.ts";
+
+interface HostedSession {
+	session: AgentSession;
+	services: AgentSessionServices;
+}
+
+export interface AcpSessionHost {
+	newSession(params: acp.NewSessionRequest): Promise<acp.NewSessionResponse>;
+	loadSession(params: acp.LoadSessionRequest): Promise<acp.LoadSessionResponse>;
+	setConfigOption(params: acp.SetSessionConfigOptionRequest): Promise<acp.SetSessionConfigOptionResponse>;
+	prompt(params: acp.PromptRequest): Promise<acp.PromptResponse>;
+	cancel(params: acp.CancelNotification): Promise<void>;
+	dispose(): Promise<void>;
+}
+
+function modelValue(model: Model<any>): string {
+	return `${model.provider}/${model.id}`;
+}
+
+export async function buildSessionConfig(
+	session: AgentSession,
+	models: readonly Model<any>[],
+): Promise<acp.SessionConfigOption[]> {
+	if (!session.model) {
+		throw acp.RequestError.authRequired(undefined, "No authenticated model is available. Configure a provider API key first.");
+	}
+	return [
+		{
+			type: "select",
+			id: "model",
+			name: "Model",
+			category: "model",
+			currentValue: modelValue(session.model),
+			options: models.map((model) => ({ value: modelValue(model), name: model.name })),
+		},
+		{
+			type: "select",
+			id: "thought_level",
+			name: "Thinking level",
+			category: "thought_level",
+			currentValue: session.thinkingLevel,
+			options: session.getAvailableThinkingLevels().map((level) => ({ value: level, name: level })),
+		},
+	];
+}
+
+function validateRequest(params: { cwd: string; mcpServers: acp.McpServer[]; additionalDirectories?: string[] }): string {
+	if (!isAbsolute(params.cwd)) {
+		throw acp.RequestError.invalidParams({ cwd: params.cwd }, "Session cwd must be an absolute path");
+	}
+	if (params.mcpServers.length > 0) {
+		throw acp.RequestError.invalidParams(undefined, "Bangboo ACP does not support MCP servers yet");
+	}
+	if ((params.additionalDirectories?.length ?? 0) > 0) {
+		throw acp.RequestError.invalidParams(undefined, "Bangboo ACP does not support additional workspace roots yet");
+	}
+	return resolve(params.cwd);
+}
+
+export function createBangbooSessionHost(options: {
+	client: acp.AgentContext;
+	extensionFactories: InlineExtension[];
+}): AcpSessionHost {
+	const sessions = new Map<string, HostedSession>();
+	let disposed = false;
+
+	async function createRuntime(cwd: string, sessionManager: SessionManager): Promise<HostedSession> {
+		const agentDir = getAgentDir();
+		const trustStore = new ProjectTrustStore(agentDir);
+		const settingsManager = SettingsManager.create(cwd, agentDir, {
+			projectTrusted: trustStore.get(cwd) === true,
+		});
+		const services = await createAgentSessionServices({
+			cwd,
+			agentDir,
+			settingsManager,
+			resourceLoaderOptions: { extensionFactories: options.extensionFactories },
+		});
+		const errors = services.diagnostics.filter((diagnostic) => diagnostic.type === "error");
+		if (errors.length > 0) {
+			await settingsManager.flush();
+			throw new Error(errors.map((diagnostic) => diagnostic.message).join("\n"));
+		}
+		const created = await createAgentSessionFromServices({ services, sessionManager });
+		const available = await services.modelRuntime.getAvailable();
+		if (!created.session.model || !available.some((model) => modelValue(model) === modelValue(created.session.model!))) {
+			created.session.dispose();
+			await settingsManager.flush();
+			throw acp.RequestError.authRequired(undefined, "No authenticated model is available. Configure a provider API key first.");
+		}
+		return { ...created, services };
+	}
+
+	async function config(hosted: HostedSession): Promise<acp.SessionConfigOption[]> {
+		return buildSessionConfig(hosted.session, await hosted.services.modelRuntime.getAvailable());
+	}
+
+	function getSession(sessionId: string): HostedSession {
+		const hosted = sessions.get(sessionId);
+		if (!hosted) throw acp.RequestError.invalidParams({ sessionId }, "Unknown session ID");
+		return hosted;
+	}
+
+	return {
+		async newSession(params) {
+			const cwd = validateRequest(params);
+			const hosted = await createRuntime(cwd, SessionManager.create(cwd));
+			const sessionId = hosted.session.sessionManager.getSessionId();
+			sessions.set(sessionId, hosted);
+			return { sessionId, configOptions: await config(hosted) };
+		},
+		async loadSession(params) {
+			const cwd = validateRequest(params);
+			const match = (await SessionManager.list(cwd)).find((entry) => entry.id === params.sessionId);
+			if (!match) throw acp.RequestError.invalidParams({ sessionId: params.sessionId }, "Unknown session ID");
+			if (normalize(resolve(match.cwd)) !== normalize(cwd)) {
+				throw acp.RequestError.invalidParams({ cwd: params.cwd }, "Session belongs to a different working directory");
+			}
+			const hosted = await createRuntime(cwd, SessionManager.open(match.path));
+			sessions.set(params.sessionId, hosted);
+			return { configOptions: await config(hosted) };
+		},
+		async setConfigOption(params) {
+			const hosted = getSession(params.sessionId);
+			if (typeof params.value !== "string") {
+				throw acp.RequestError.invalidParams({ configId: params.configId }, "Configuration value must be a string");
+			}
+			if (params.configId === "model") {
+				const available = await hosted.services.modelRuntime.getAvailable();
+				const model = available.find((candidate) => modelValue(candidate) === params.value);
+				if (!model) throw acp.RequestError.invalidParams({ value: params.value }, "Unknown or unauthenticated model");
+				await hosted.session.setModel(model);
+			} else if (params.configId === "thought_level") {
+				const levels = hosted.session.getAvailableThinkingLevels();
+				if (!levels.includes(params.value as ThinkingLevel)) {
+					throw acp.RequestError.invalidParams({ value: params.value }, "Unsupported thinking level for the selected model");
+				}
+				hosted.session.setThinkingLevel(params.value as ThinkingLevel);
+			} else {
+				throw acp.RequestError.invalidParams({ configId: params.configId }, "Unknown config option");
+			}
+			return { configOptions: await config(hosted) };
+		},
+		async prompt() {
+			throw acp.RequestError.methodNotFound(acp.methods.agent.session.prompt);
+		},
+		async cancel(params) {
+			await getSession(params.sessionId).session.abort();
+		},
+		async dispose() {
+			if (disposed) return;
+			disposed = true;
+			await Promise.all(
+				[...sessions.values()].map(async ({ session, services }) => {
+					await session.abort();
+					await services.settingsManager.flush();
+					session.dispose();
+				}),
+			);
+			sessions.clear();
+		},
+	};
+}
