+++ b/packages/coding-agent/src/modes/acp/content.ts
@@ -0,0 +1,21 @@
+import * as acp from "@agentclientprotocol/sdk";
+import type { ImageContent } from "@earendil-works/pi-ai";
+
+export function toBangbooPrompt(
+	prompt: acp.ContentBlock[],
+	imageSupported: boolean,
+): { text: string; images: ImageContent[] } {
+	const text: string[] = [];
+	const images: ImageContent[] = [];
+	for (const block of prompt) {
+		if (block.type === "text") {
+			text.push(block.text);
+		} else if (block.type === "image") {
+			if (!imageSupported) throw acp.RequestError.invalidParams(undefined, "The selected model does not support images");
+			images.push({ type: "image", data: block.data, mimeType: block.mimeType });
+		} else {
+			throw acp.RequestError.invalidParams(undefined, `Unsupported prompt content type: ${block.type}`);
+		}
+	}
+	return { text: text.join("\n\n"), images };
+}
diff --git a/packages/coding-agent/src/modes/acp/event-mapper.ts b/packages/coding-agent/src/modes/acp/event-mapper.ts
new file mode 100644
index 00000000..430811e8
--- /dev/null
+++ b/packages/coding-agent/src/modes/acp/event-mapper.ts
@@ -0,0 +1,105 @@
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import * as acp from "@agentclientprotocol/sdk";
+import type { AgentSessionEvent } from "../../core/agent-session.ts";
+
+const TOOL_KIND: Record<string, acp.ToolKind> = {
+	read: "read", edit: "edit", write: "edit", grep: "search", find: "search", ls: "search", bash: "execute",
+};
+
+function contentBlocks(content: unknown): acp.ContentBlock[] {
+	if (typeof content === "string") return [{ type: "text", text: content }];
+	if (!Array.isArray(content)) return [];
+	return content.flatMap((block): acp.ContentBlock[] => {
+		if (!block || typeof block !== "object") return [];
+		if ((block as { type?: string }).type === "text") return [{ type: "text", text: String((block as { text?: unknown }).text ?? "") }];
+		if ((block as { type?: string }).type === "image") {
+			const image = block as { data: string; mimeType: string };
+			return [{ type: "image", data: image.data, mimeType: image.mimeType }];
+		}
+		return [];
+	});
+}
+
+function toolContent(result: unknown): acp.ToolCallContent[] | undefined {
+	if (!result || typeof result !== "object") return undefined;
+	const value = result as { content?: unknown; details?: unknown };
+	const content: acp.ToolCallContent[] = contentBlocks(value.content).map((block) => ({ type: "content", content: block }));
+	if (value.details && typeof value.details === "object") {
+		const details = value.details as { patch?: unknown; diff?: unknown; path?: unknown };
+		const patch = typeof details.patch === "string" ? details.patch : typeof details.diff === "string" ? details.diff : undefined;
+		if (patch) content.push({ type: "diff", path: typeof details.path === "string" ? details.path : "/", oldText: "", newText: patch });
+	}
+	return content.length ? content : undefined;
+}
+
+export function mapAgentSessionEvent(event: AgentSessionEvent): acp.SessionUpdate[] {
+	if (event.type === "message_update") {
+		const update = event.assistantMessageEvent;
+		const messageId = `assistant:${event.message.timestamp}`;
+		if (update.type === "text_delta") return [{ sessionUpdate: "agent_message_chunk", messageId, content: { type: "text", text: update.delta } }];
+		if (update.type === "thinking_delta") return [{ sessionUpdate: "agent_thought_chunk", messageId: `${messageId}:thinking`, content: { type: "text", text: update.delta } }];
+	}
+	if (event.type === "tool_execution_start") return [{ sessionUpdate: "tool_call", toolCallId: event.toolCallId, kind: TOOL_KIND[event.toolName] ?? "other", status: "in_progress", rawInput: event.args, title: event.toolName }];
+	if (event.type === "tool_execution_update") return [{ sessionUpdate: "tool_call_update", toolCallId: event.toolCallId, content: toolContent(event.partialResult), rawOutput: event.partialResult }];
+	if (event.type === "tool_execution_end") return [{ sessionUpdate: "tool_call_update", toolCallId: event.toolCallId, status: event.isError ? "failed" : "completed", content: toolContent(event.result), rawOutput: event.result }];
+	return [];
+}
+
+export async function replaySessionHistory(
+	sessionId: string,
+	messages: AgentMessage[],
+	client: acp.AgentContext,
+): Promise<void> {
+	const replayedToolCalls = new Set<string>();
+	const notify = (update: acp.SessionUpdate): Promise<void> =>
+		client.notify(acp.methods.client.session.update, { sessionId, update });
+	for (const [index, message] of messages.entries()) {
+		const messageId = `${sessionId}:history:${index}`;
+		if (message.role === "user") {
+			for (const content of contentBlocks(message.content)) {
+				await notify({ sessionUpdate: "user_message_chunk", messageId, content });
+			}
+		} else if (message.role === "assistant") {
+			for (const [blockIndex, block] of message.content.entries()) {
+				if (block.type === "text") {
+					await notify({ sessionUpdate: "agent_message_chunk", messageId, content: { type: "text", text: block.text } });
+				} else if (block.type === "thinking") {
+					await notify({
+						sessionUpdate: "agent_thought_chunk",
+						messageId: `${messageId}:thinking:${blockIndex}`,
+						content: { type: "text", text: block.thinking },
+					});
+				} else if (block.type === "toolCall") {
+					replayedToolCalls.add(block.id);
+					await notify({
+						sessionUpdate: "tool_call",
+						toolCallId: block.id,
+						title: block.name,
+						kind: TOOL_KIND[block.name] ?? "other",
+						status: "in_progress",
+						rawInput: block.arguments,
+					});
+				}
+			}
+		} else if (message.role === "toolResult") {
+			if (!replayedToolCalls.has(message.toolCallId)) {
+				replayedToolCalls.add(message.toolCallId);
+				await notify({
+					sessionUpdate: "tool_call",
+					toolCallId: message.toolCallId,
+					title: message.toolName,
+					kind: TOOL_KIND[message.toolName] ?? "other",
+					status: "in_progress",
+				});
+			}
+			await notify({
+				sessionUpdate: "tool_call_update",
+				toolCallId: message.toolCallId,
+				title: message.toolName,
+				status: message.isError ? "failed" : "completed",
+				content: contentBlocks(message.content).map((content) => ({ type: "content", content })),
+				rawOutput: message,
+			});
+		}
+	}
+}
diff --git a/packages/coding-agent/src/modes/acp/permission-gate.ts b/packages/coding-agent/src/modes/acp/permission-gate.ts
new file mode 100644
index 00000000..e3184081
--- /dev/null
+++ b/packages/coding-agent/src/modes/acp/permission-gate.ts
@@ -0,0 +1,86 @@
+import * as acp from "@agentclientprotocol/sdk";
+import type { InlineExtension, ToolCallEvent } from "../../core/extensions/types.ts";
+
+const READ_ONLY_TOOLS = new Set(["read", "grep", "find", "ls"]);
+const TOOL_KIND: Record<string, acp.ToolKind> = {
+	edit: "edit",
+	write: "edit",
+	bash: "execute",
+};
+
+const OPTIONS: acp.PermissionOption[] = [
+	{ optionId: "allow_once", name: "Allow once", kind: "allow_once" },
+	{ optionId: "allow_session", name: "Allow for this session", kind: "allow_always" },
+	{ optionId: "deny", name: "Deny", kind: "reject_once" },
+];
+
+export interface AcpPermissionBroker {
+	request(event: ToolCallEvent): Promise<"allow" | "deny">;
+	cancelPending(): void;
+}
+
+export function createAcpClientPermissionBroker(options: {
+	client: acp.AgentContext;
+	sessionId: string;
+	sessionApprovals: Set<string>;
+}): AcpPermissionBroker {
+	const pending = new Set<() => void>();
+	const clientSignal = (options.client as acp.AgentContext & { signal?: AbortSignal }).signal;
+
+	return {
+		async request(event) {
+			if (options.sessionApprovals.has(event.toolName)) return "allow";
+			if (clientSignal?.aborted) return "deny";
+			return new Promise<"allow" | "deny">((resolve) => {
+				let settled = false;
+				const settle = (decision: "allow" | "deny"): void => {
+					if (settled) return;
+					settled = true;
+					pending.delete(cancel);
+					clientSignal?.removeEventListener("abort", cancel);
+					resolve(decision);
+				};
+				const cancel = (): void => settle("deny");
+				pending.add(cancel);
+				clientSignal?.addEventListener("abort", cancel, { once: true });
+				void Promise.resolve().then(() => options.client.request(
+					acp.methods.client.session.requestPermission,
+					{
+						sessionId: options.sessionId,
+						toolCall: {
+							toolCallId: event.toolCallId,
+							title: event.toolName,
+							kind: TOOL_KIND[event.toolName] ?? "other",
+							rawInput: event.input,
+						},
+						options: OPTIONS,
+					},
+				)).then((response) => {
+					if (settled) return;
+					const outcome = response?.outcome;
+					if (outcome?.outcome !== "selected") return settle("deny");
+					if (outcome.optionId === "allow_session") {
+						options.sessionApprovals.add(event.toolName);
+						return settle("allow");
+					}
+					settle(outcome.optionId === "allow_once" ? "allow" : "deny");
+				}, () => settle("deny"));
+			});
+		},
+		cancelPending() {
+			for (const cancel of [...pending]) cancel();
+		},
+	};
+}
+
+export function createAcpPermissionExtension(broker: AcpPermissionBroker): InlineExtension {
+	return (api) => {
+		api.on("tool_call", async (event) => {
+			if (READ_ONLY_TOOLS.has(event.toolName)) return undefined;
+			const decision = await broker.request(event);
+			return decision === "allow"
+				? undefined
+				: { block: true, reason: "Tool execution denied by ACP client" };
+		});
+	};
+}
diff --git a/packages/coding-agent/src/modes/acp/session-host.ts b/packages/coding-agent/src/modes/acp/session-host.ts
new file mode 100644
index 00000000..c58530dc
--- /dev/null
+++ b/packages/coding-agent/src/modes/acp/session-host.ts
@@ -0,0 +1,325 @@
+import { isAbsolute, normalize, resolve } from "node:path";
+import type { ThinkingLevel } from "@earendil-works/pi-agent-core";
+import type { Model } from "@earendil-works/pi-ai";
+import * as acp from "@agentclientprotocol/sdk";
+import { getAgentDir } from "../../config.ts";
+import {
+	createAgentSessionFromServices,
+	createAgentSessionServices,
+	type AgentSessionServices,
+} from "../../core/agent-session-services.ts";
+import type { AgentSession } from "../../core/agent-session.ts";
+import type { InlineExtension } from "../../core/extensions/types.ts";
+import { SessionManager } from "../../core/session-manager.ts";
+import { SettingsManager } from "../../core/settings-manager.ts";
+import { ProjectTrustStore } from "../../core/trust-manager.ts";
+import { toBangbooPrompt } from "./content.ts";
+import { mapAgentSessionEvent, replaySessionHistory } from "./event-mapper.ts";
+import {
+	createAcpClientPermissionBroker,
+	createAcpPermissionExtension,
+	type AcpPermissionBroker,
+} from "./permission-gate.ts";
+
+export interface HostedSession {
+	session: AgentSession;
+	services: AgentSessionServices;
+}
+
+export interface AcpSessionHostDependencies {
+	createRuntime(cwd: string, sessionManager: SessionManager, extensionFactories: InlineExtension[]): Promise<HostedSession>;
+	createSessionManager(cwd: string): SessionManager;
+	openSessionManager(path: string): SessionManager;
+	listSessions(cwd: string): ReturnType<typeof SessionManager.list>;
+}
+
+export interface AcpSessionHost {
+	newSession(params: acp.NewSessionRequest): Promise<acp.NewSessionResponse>;
+	loadSession(params: acp.LoadSessionRequest): Promise<acp.LoadSessionResponse>;
+	setConfigOption(params: acp.SetSessionConfigOptionRequest): Promise<acp.SetSessionConfigOptionResponse>;
+	prompt(params: acp.PromptRequest): Promise<acp.PromptResponse>;
+	cancel(params: acp.CancelNotification): Promise<void>;
+	dispose(): Promise<void>;
+}
+
+function modelValue(model: Model<any>): string {
+	return `${model.provider}/${model.id}`;
+}
+
+function settledStopReason(session: AgentSession): acp.StopReason | undefined {
+	let final: (typeof session.messages)[number] | undefined;
+	for (let index = session.messages.length - 1; index >= 0; index--) {
+		if (session.messages[index].role === "assistant") {
+			final = session.messages[index];
+			break;
+		}
+	}
+	if (!final || final.role !== "assistant") return undefined;
+	if (final.stopReason === "length") return "max_tokens";
+	const metadata = `${final.rawStopReason ?? ""}\n${final.errorMessage ?? ""}`;
+	if (/refus|safety|content.?filter/i.test(metadata)) return "refusal";
+	if (/context|token limit|too long/i.test(metadata)) return "max_tokens";
+	return undefined;
+}
+
+export async function buildSessionConfig(
+	session: AgentSession,
+	models: readonly Model<any>[],
+): Promise<acp.SessionConfigOption[]> {
+	if (!session.model) {
+		throw acp.RequestError.authRequired(undefined, "No authenticated model is available. Configure a provider API key first.");
+	}
+	return [
+		{
+			type: "select",
+			id: "model",
+			name: "Model",
+			category: "model",
+			currentValue: modelValue(session.model),
+			options: models.map((model) => ({ value: modelValue(model), name: model.name })),
+		},
+		{
+			type: "select",
+			id: "thought_level",
+			name: "Thinking level",
+			category: "thought_level",
+			currentValue: session.thinkingLevel,
+			options: session.getAvailableThinkingLevels().map((level) => ({ value: level, name: level })),
+		},
+	];
+}
+
+function validateRequest(params: { cwd: string; mcpServers: acp.McpServer[]; additionalDirectories?: string[] }): string {
+	if (!isAbsolute(params.cwd)) {
+		throw acp.RequestError.invalidParams({ cwd: params.cwd }, "Session cwd must be an absolute path");
+	}
+	if (params.mcpServers.length > 0) {
+		throw acp.RequestError.invalidParams(undefined, "Bangboo ACP does not support MCP servers yet");
+	}
+	if ((params.additionalDirectories?.length ?? 0) > 0) {
+		throw acp.RequestError.invalidParams(undefined, "Bangboo ACP does not support additional workspace roots yet");
+	}
+	return resolve(params.cwd);
+}
+
+async function createRuntime(
+	cwd: string,
+	sessionManager: SessionManager,
+	extensionFactories: InlineExtension[],
+): Promise<HostedSession> {
+	const agentDir = getAgentDir();
+	const trustStore = new ProjectTrustStore(agentDir);
+	const settingsManager = SettingsManager.create(cwd, agentDir, {
+		projectTrusted: trustStore.get(cwd) === true,
+	});
+	const services = await createAgentSessionServices({
+		cwd,
+		agentDir,
+		settingsManager,
+		resourceLoaderOptions: { extensionFactories },
+	});
+	const errors = services.diagnostics.filter((diagnostic) => diagnostic.type === "error");
+	if (errors.length > 0) {
+		await settingsManager.flush();
+		throw new Error(errors.map((diagnostic) => diagnostic.message).join("\n"));
+	}
+	const created = await createAgentSessionFromServices({ services, sessionManager });
+	const available = await services.modelRuntime.getAvailable();
+	if (!created.session.model || !available.some((model) => modelValue(model) === modelValue(created.session.model!))) {
+		created.session.dispose();
+		await settingsManager.flush();
+		throw acp.RequestError.authRequired(undefined, "No authenticated model is available. Configure a provider API key first.");
+	}
+	return { ...created, services };
+}
+
+const defaultDependencies: AcpSessionHostDependencies = {
+	createRuntime,
+	createSessionManager: (cwd) => SessionManager.create(cwd),
+	openSessionManager: (path) => SessionManager.open(path),
+	listSessions: (cwd) => SessionManager.list(cwd),
+};
+
+export function createBangbooSessionHost(options: {
+	client: acp.AgentContext;
+	extensionFactories: InlineExtension[];
+	dependencies?: Partial<AcpSessionHostDependencies>;
+}): AcpSessionHost {
+	const dependencies = { ...defaultDependencies, ...options.dependencies };
+	const sessions = new Map<string, HostedSession>();
+	const permissionBrokers = new Map<string, AcpPermissionBroker>();
+	const sessionApprovals = new Set<string>();
+	const reservedSessionIds = new Set<string>();
+	const activePrompts = new Map<string, Promise<acp.PromptResponse>>();
+	const cancelledPrompts = new Set<string>();
+	let disposed = false;
+
+	async function disposeHosted({ session, services }: HostedSession, broker?: AcpPermissionBroker): Promise<void> {
+		broker?.cancelPending();
+		await session.abort();
+		await services.settingsManager.flush();
+		session.dispose();
+	}
+
+	async function config(hosted: HostedSession): Promise<acp.SessionConfigOption[]> {
+		return buildSessionConfig(hosted.session, await hosted.services.modelRuntime.getAvailable());
+	}
+
+	function getSession(sessionId: string): HostedSession {
+		const hosted = sessions.get(sessionId);
+		if (!hosted) throw acp.RequestError.invalidParams({ sessionId }, "Unknown session ID");
+		return hosted;
+	}
+
+	function reserveSessionId(sessionId: string): void {
+		if (sessions.has(sessionId) || reservedSessionIds.has(sessionId)) {
+			throw acp.RequestError.invalidParams({ sessionId }, "Session ID is already hosted");
+		}
+		reservedSessionIds.add(sessionId);
+	}
+
+	async function installSession(
+		sessionId: string,
+		create: (extensionFactories: InlineExtension[]) => Promise<HostedSession>,
+	): Promise<{ hosted: HostedSession; configOptions: acp.SessionConfigOption[] }> {
+		let hosted: HostedSession | undefined;
+		const broker = createAcpClientPermissionBroker({ client: options.client, sessionId, sessionApprovals });
+		try {
+			hosted = await create([...options.extensionFactories, createAcpPermissionExtension(broker)]);
+			sessions.set(sessionId, hosted);
+			permissionBrokers.set(sessionId, broker);
+			return { hosted, configOptions: await config(hosted) };
+		} catch (error) {
+			broker.cancelPending();
+			if (hosted) {
+				sessions.delete(sessionId);
+				permissionBrokers.delete(sessionId);
+				await disposeHosted(hosted, broker);
+			}
+			throw error;
+		} finally {
+			reservedSessionIds.delete(sessionId);
+		}
+	}
+
+	return {
+		async newSession(params) {
+			const cwd = validateRequest(params);
+			const sessionManager = dependencies.createSessionManager(cwd);
+			const sessionId = sessionManager.getSessionId();
+			reserveSessionId(sessionId);
+			const installed = await installSession(sessionId, (extensionFactories) =>
+				dependencies.createRuntime(cwd, sessionManager, extensionFactories),
+			);
+			return { sessionId, configOptions: installed.configOptions };
+		},
+		async loadSession(params) {
+			const cwd = validateRequest(params);
+			reserveSessionId(params.sessionId);
+			const installed = await installSession(params.sessionId, async (extensionFactories) => {
+				const match = (await dependencies.listSessions(cwd)).find((entry) => entry.id === params.sessionId);
+				if (!match) throw acp.RequestError.invalidParams({ sessionId: params.sessionId }, "Unknown session ID");
+				if (normalize(resolve(match.cwd)) !== normalize(cwd)) {
+					throw acp.RequestError.invalidParams({ cwd: params.cwd }, "Session belongs to a different working directory");
+				}
+				return dependencies.createRuntime(
+					cwd,
+					dependencies.openSessionManager(match.path),
+					extensionFactories,
+				);
+			});
+			await replaySessionHistory(params.sessionId, installed.hosted.session.messages ?? [], options.client);
+			return { configOptions: installed.configOptions };
+		},
+		async setConfigOption(params) {
+			const hosted = getSession(params.sessionId);
+			if (typeof params.value !== "string") {
+				throw acp.RequestError.invalidParams({ configId: params.configId }, "Configuration value must be a string");
+			}
+			if (params.configId === "model") {
+				const available = await hosted.services.modelRuntime.getAvailable();
+				const model = available.find((candidate) => modelValue(candidate) === params.value);
+				if (!model) throw acp.RequestError.invalidParams({ value: params.value }, "Unknown or unauthenticated model");
+				await hosted.session.setModel(model);
+			} else if (params.configId === "thought_level") {
+				const levels = hosted.session.getAvailableThinkingLevels();
+				if (!levels.includes(params.value as ThinkingLevel)) {
+					throw acp.RequestError.invalidParams({ value: params.value }, "Unsupported thinking level for the selected model");
+				}
+				hosted.session.setThinkingLevel(params.value as ThinkingLevel);
+			} else {
+				throw acp.RequestError.invalidParams({ configId: params.configId }, "Unknown config option");
+			}
+			return { configOptions: await config(hosted) };
+		},
+		async prompt(params) {
+			const hosted = getSession(params.sessionId);
+			if (activePrompts.has(params.sessionId)) {
+				throw acp.RequestError.invalidParams({ sessionId: params.sessionId }, "A prompt is already running");
+			}
+			const converted = toBangbooPrompt(params.prompt, hosted.session.model?.input.includes("image") === true);
+			const run = (async (): Promise<acp.PromptResponse> => {
+				let delivery = Promise.resolve();
+				const unsubscribe = hosted.session.subscribe((event) => {
+					for (const update of mapAgentSessionEvent(event)) {
+						delivery = delivery.then(() =>
+							options.client.notify(acp.methods.client.session.update, { sessionId: params.sessionId, update }),
+						);
+					}
+					if (event.type === "agent_settled") {
+						const usage = hosted.session.getContextUsage();
+						if (usage?.tokens != null && usage.contextWindow != null) {
+							delivery = delivery.then(() => options.client.notify(acp.methods.client.session.update, {
+								sessionId: params.sessionId,
+								update: { sessionUpdate: "usage_update", used: usage.tokens, size: usage.contextWindow },
+							}));
+						}
+					}
+				});
+				try {
+					await hosted.session.prompt(converted.text, { images: converted.images, source: "rpc" });
+					await delivery;
+					return {
+						stopReason: cancelledPrompts.has(params.sessionId)
+							? "cancelled"
+							: settledStopReason(hosted.session) ?? "end_turn",
+					};
+				} catch (error) {
+					await delivery;
+					const message = error instanceof Error ? error.message : String(error);
+					if (cancelledPrompts.has(params.sessionId) || /abort|cancel/i.test(message)) return { stopReason: "cancelled" };
+					if (/context|token limit|too long/i.test(message)) return { stopReason: "max_tokens" };
+					if (/refus/i.test(message)) return { stopReason: "refusal" };
+					throw error;
+				} finally {
+					unsubscribe();
+				}
+			})();
+			activePrompts.set(params.sessionId, run);
+			try {
+				return await run;
+			} finally {
+				activePrompts.delete(params.sessionId);
+				cancelledPrompts.delete(params.sessionId);
+			}
+		},
+		async cancel(params) {
+			const hosted = getSession(params.sessionId);
+			permissionBrokers.get(params.sessionId)?.cancelPending();
+			const active = activePrompts.get(params.sessionId);
+			if (!active) return;
+			cancelledPrompts.add(params.sessionId);
+			await hosted.session.abort();
+			await active;
+		},
+		async dispose() {
+			if (disposed) return;
+			disposed = true;
+			await Promise.all([...sessions.entries()].map(([sessionId, hosted]) =>
+				disposeHosted(hosted, permissionBrokers.get(sessionId)),
+			));
+			sessions.clear();
+			permissionBrokers.clear();
+		},
+	};
+}
