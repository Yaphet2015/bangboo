@@ -0,0 +1,43 @@
+import * as acp from "@agentclientprotocol/sdk";
+import { describe, expect, it, vi } from "vitest";
+import { createAcpAgentApp } from "../../src/modes/acp/acp-mode.ts";
+import type { AcpSessionHost } from "../../src/modes/acp/session-host.ts";
+
+function fakeHost(): AcpSessionHost {
+	return {
+		newSession: vi.fn(async () => ({ sessionId: "session-1", configOptions: [] })),
+		loadSession: vi.fn(async () => ({ configOptions: [] })),
+		setConfigOption: vi.fn(async () => ({ configOptions: [] })),
+		prompt: vi.fn(async () => ({ stopReason: "end_turn" })),
+		cancel: vi.fn(async () => {}),
+		dispose: vi.fn(async () => {}),
+	};
+}
+
+describe("ACP session lifecycle routing", () => {
+	it("routes standard session lifecycle and configuration methods", async () => {
+		const host = fakeHost();
+		const client = acp.client({ name: "test-client" });
+		await client.connectWith(createAcpAgentApp({ hostFactory: () => host }), async (agent) => {
+			await agent.request(acp.methods.agent.session.new, { cwd: "/tmp/project", mcpServers: [] });
+			await agent.request(acp.methods.agent.session.load, {
+				cwd: "/tmp/project",
+				sessionId: "session-1",
+				mcpServers: [],
+			});
+			await agent.request(acp.methods.agent.session.setConfigOption, {
+				sessionId: "session-1",
+				configId: "model",
+				value: "provider/model",
+			});
+		});
+
+		expect(host.newSession).toHaveBeenCalledWith({ cwd: "/tmp/project", mcpServers: [] });
+		expect(host.loadSession).toHaveBeenCalledWith({ cwd: "/tmp/project", sessionId: "session-1", mcpServers: [] });
+		expect(host.setConfigOption).toHaveBeenCalledWith({
+			sessionId: "session-1",
+			configId: "model",
+			value: "provider/model",
+		});
+	});
+});
