+		throw acp.RequestError.invalidParams(undefined, "Invalid sessionConfig version 1");
+	}
+	const model = raw.modelId ?? raw.configOptionValues.model;
+	const thinkingLevel = raw.configOptionValues.thought_level;
+	if (model !== undefined && (typeof model !== "string" || !model.trim())) {
+		throw acp.RequestError.invalidParams(undefined, "Invalid sessionConfig model");
+	}
+	if (thinkingLevel !== undefined && (typeof thinkingLevel !== "string" || !thinkingLevel.trim())) {
+		throw acp.RequestError.invalidParams(undefined, "Invalid sessionConfig thinking level");
+	}
+	return { model, thinkingLevel };
