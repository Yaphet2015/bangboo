new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/bangboo.ts
@@ -0,0 +1,26 @@
+#!/usr/bin/env node
+
+const compatibilityVariables = [
+	"OFFLINE",
+	"SHARE_VIEWER_URL",
+	"TIMING",
+	"STARTUP_BENCHMARK",
+	"EXPERIMENTAL",
+	"CLEAR_ON_SHRINK",
+	"HARDWARE_CURSOR",
+	"PACKAGE_DIR",
+] as const;
+
+for (const suffix of compatibilityVariables) {
+	const publicName = `BANGBOO_${suffix}`;
+	const compatibilityName = `PI_${suffix}`;
+	if (process.env[publicName] !== undefined) {
+		process.env[compatibilityName] = process.env[publicName];
+	}
+}
+
+process.env.BANGBOO_CODING_AGENT = "true";
+process.env.PI_CODING_AGENT = "true";
+process.env.PI_TELEMETRY = "0";
+
+await import("./cli.ts");
