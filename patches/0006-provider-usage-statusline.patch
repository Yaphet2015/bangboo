diff --git a/packages/coding-agent/src/core/provider-usage.ts b/packages/coding-agent/src/core/provider-usage.ts
new file mode 100644
index 00000000..135b59c7
--- /dev/null
+++ b/packages/coding-agent/src/core/provider-usage.ts
@@ -0,0 +1,183 @@
+export interface ProviderUsage {
+	remainingPercent: number;
+	windowLabel: string;
+}
+
+type HeaderMap = Record<string, string | undefined>;
+type FetchResponse = { ok: boolean; json(): Promise<unknown> };
+type FetchFunction = (
+	url: string,
+	init: { headers: Record<string, string>; signal: AbortSignal },
+) => Promise<FetchResponse>;
+
+const CODEX_USAGE_ENDPOINT = "https://chatgpt.com/backend-api/wham/usage";
+const WEEK_SECONDS = 604_800;
+const SUPPORTED_PROVIDERS = new Set(["openai-codex", "zai", "zai-coding-cn"]);
+const ZAI_ENDPOINTS: Record<string, string> = {
+	zai: "https://api.z.ai/api/monitor/usage/quota/limit",
+	"zai-coding-cn": "https://open.bigmodel.cn/api/monitor/usage/quota/limit",
+};
+
+function finiteNumber(value: unknown): number | undefined {
+	const number =
+		typeof value === "number" ? value : typeof value === "string" && value.trim() ? Number(value) : Number.NaN;
+	return Number.isFinite(number) ? number : undefined;
+}
+
+function normalizePercent(value: number): number {
+	return Math.round(Math.min(100, Math.max(0, value)));
+}
+
+export function parseCodexWeeklyUsage(headers: HeaderMap): ProviderUsage | undefined {
+	const used = finiteNumber(headers["x-codex-secondary-used-percent"]);
+	const windowMinutes = finiteNumber(headers["x-codex-secondary-window-minutes"]);
+	if (used === undefined || windowMinutes !== 10_080) return undefined;
+	return { remainingPercent: normalizePercent(100 - used), windowLabel: "weekly" };
+}
+
+export function parseCodexUsage(payload: unknown): ProviderUsage | undefined {
+	if (!payload || typeof payload !== "object") return undefined;
+	const rateLimit = (payload as { rate_limit?: unknown }).rate_limit;
+	if (!rateLimit || typeof rateLimit !== "object") return undefined;
+	const windows = [
+		(rateLimit as { primary_window?: unknown }).primary_window,
+		(rateLimit as { secondary_window?: unknown }).secondary_window,
+	];
+	for (const value of windows) {
+		if (!value || typeof value !== "object") continue;
+		const window = value as Record<string, unknown>;
+		const used = finiteNumber(window.used_percent);
+		const seconds = finiteNumber(window.limit_window_seconds);
+		if (used !== undefined && seconds === WEEK_SECONDS) {
+			return { remainingPercent: normalizePercent(100 - used), windowLabel: "weekly" };
+		}
+	}
+	return undefined;
+}
+
+function formatWindow(numberValue: unknown, unitValue: unknown): string | undefined {
+	const number = finiteNumber(numberValue);
+	if (number === undefined || number <= 0) return undefined;
+	const unit = typeof unitValue === "string" ? unitValue.toLowerCase() : unitValue;
+	if (unit === 6 && number === 1) return "weekly";
+	let suffix: string | undefined;
+	if (unit === 3 || unit === "hour" || unit === "hours" || unit === "h") suffix = "h";
+	else if (unit === 4 || unit === "day" || unit === "days" || unit === "d") suffix = "d";
+	else if (unit === 2 || unit === "minute" || unit === "minutes" || unit === "m") suffix = "m";
+	return suffix ? `${number}${suffix}` : undefined;
+}
+
+export function parseZaiUsage(payload: unknown): ProviderUsage | undefined {
+	if (!payload || typeof payload !== "object") return undefined;
+	const data = (payload as { data?: unknown }).data;
+	if (!data || typeof data !== "object") return undefined;
+	const limits = (data as { limits?: unknown }).limits;
+	if (!Array.isArray(limits)) return undefined;
+	const limit = limits.find(
+		(value): value is Record<string, unknown> =>
+			!!value && typeof value === "object" && (value as { type?: unknown }).type === "TOKENS_LIMIT",
+	);
+	if (!limit) return undefined;
+	const windowLabel = formatWindow(limit.number, limit.unit);
+	if (!windowLabel) return undefined;
+	const explicitRemaining = finiteNumber(limit.remainingPercentage ?? limit.remainingPercent);
+	const consumed = finiteNumber(limit.percentage);
+	const remaining = explicitRemaining ?? (consumed === undefined ? undefined : 100 - consumed);
+	if (remaining === undefined) return undefined;
+	return { remainingPercent: normalizePercent(remaining), windowLabel };
+}
+
+export function applyProviderUsageStatus(
+	text: string | undefined,
+	setStatus: (key: string, text: string | undefined) => void,
+	requestRender: () => void,
+): void {
+	setStatus("bangboo-provider-usage", text);
+	requestRender();
+}
+
+export interface ProviderUsageTrackerOptions {
+	getApiKey(provider: string): Promise<string | undefined>;
+	onStatus(text: string | undefined): void;
+	fetchFn?: FetchFunction;
+	timeoutMs?: number;
+}
+
+export class ProviderUsageTracker {
+	private readonly getApiKey: ProviderUsageTrackerOptions["getApiKey"];
+	private readonly onStatus: ProviderUsageTrackerOptions["onStatus"];
+	private readonly fetchFn: FetchFunction;
+	private readonly timeoutMs: number;
+	private readonly cache = new Map<string, ProviderUsage>();
+	private selectedProvider: string | undefined;
+	private inFlight: Promise<void> | undefined;
+	private abortController: AbortController | undefined;
+
+	constructor(options: ProviderUsageTrackerOptions) {
+		this.getApiKey = options.getApiKey;
+		this.onStatus = options.onStatus;
+		this.fetchFn = options.fetchFn ?? (fetch as FetchFunction);
+		this.timeoutMs = options.timeoutMs ?? 3_000;
+	}
+
+	selectProvider(provider: string | undefined): void {
+		this.selectedProvider = provider && SUPPORTED_PROVIDERS.has(provider) ? provider : undefined;
+		this.publish(this.selectedProvider ? this.cache.get(this.selectedProvider) : undefined);
+	}
+
+	handleResponse(provider: string, headers: HeaderMap): void {
+		if (provider !== "openai-codex") return;
+		const usage = parseCodexWeeklyUsage(headers);
+		if (!usage) return;
+		this.cache.set(provider, usage);
+		if (provider === this.selectedProvider) this.publish(usage);
+	}
+
+	refreshSelectedProvider(): Promise<void> {
+		if (this.inFlight) return this.inFlight;
+		const provider = this.selectedProvider;
+		const endpoint =
+			provider === "openai-codex" ? CODEX_USAGE_ENDPOINT : provider ? ZAI_ENDPOINTS[provider] : undefined;
+		if (!provider || !endpoint) return Promise.resolve();
+		const operation = (async () => {
+			try {
+				const apiKey = await this.getApiKey(provider);
+				if (!apiKey) return;
+				const controller = new AbortController();
+				this.abortController = controller;
+				const timeout = setTimeout(() => controller.abort(), this.timeoutMs);
+				try {
+					const response = await this.fetchFn(endpoint, {
+						headers: { Authorization: `Bearer ${apiKey}` },
+						signal: controller.signal,
+					});
+					if (!response.ok) return;
+					const payload = await response.json();
+					const usage = provider === "openai-codex" ? parseCodexUsage(payload) : parseZaiUsage(payload);
+					if (!usage) return;
+					this.cache.set(provider, usage);
+					if (provider === this.selectedProvider) this.publish(usage);
+				} finally {
+					clearTimeout(timeout);
+					if (this.abortController === controller) this.abortController = undefined;
+				}
+			} catch {
+				// Quota metadata must never affect normal agent operation.
+			}
+		})();
+		const tracked = operation.finally(() => {
+			if (this.inFlight === tracked) this.inFlight = undefined;
+		});
+		this.inFlight = tracked;
+		return tracked;
+	}
+
+	dispose(): void {
+		this.abortController?.abort();
+		this.abortController = undefined;
+	}
+
+	private publish(usage: ProviderUsage | undefined): void {
+		this.onStatus(usage ? `(${usage.remainingPercent}% ${usage.windowLabel})` : undefined);
+	}
+}
