diff --git a/packages/coding-agent/test/provider-usage.test.ts b/packages/coding-agent/test/provider-usage.test.ts
new file mode 100644
index 00000000..920ce51a
--- /dev/null
+++ b/packages/coding-agent/test/provider-usage.test.ts
@@ -0,0 +1,198 @@
+import { describe, expect, test, vi } from "vitest";
+import {
+	applyProviderUsageStatus,
+	ProviderUsageTracker,
+	parseCodexUsage,
+	parseCodexWeeklyUsage,
+	parseZaiUsage,
+} from "../src/core/provider-usage.ts";
+
+describe("provider usage parsing", () => {
+	test("converts Codex weekly used percentage to remaining percentage", () => {
+		expect(
+			parseCodexWeeklyUsage({
+				"x-codex-secondary-used-percent": "28.4",
+				"x-codex-secondary-window-minutes": "10080",
+			}),
+		).toEqual({ remainingPercent: 72, windowLabel: "weekly" });
+	});
+
+	test("ignores malformed and non-weekly Codex limits", () => {
+		expect(
+			parseCodexWeeklyUsage({
+				"x-codex-secondary-used-percent": "28",
+				"x-codex-secondary-window-minutes": "300",
+			}),
+		).toBeUndefined();
+		expect(parseCodexWeeklyUsage({ "x-codex-secondary-used-percent": "nope" })).toBeUndefined();
+	});
+
+	test("parses Codex primary weekly usage returned by the usage endpoint", () => {
+		expect(
+			parseCodexUsage({
+				rate_limit: {
+					primary_window: { used_percent: 13, limit_window_seconds: 604_800 },
+					secondary_window: null,
+				},
+			}),
+		).toEqual({ remainingPercent: 87, windowLabel: "weekly" });
+	});
+
+	test("falls back to a Codex secondary weekly usage window", () => {
+		expect(
+			parseCodexUsage({
+				rate_limit: {
+					primary_window: { used_percent: 20, limit_window_seconds: 18_000 },
+					secondary_window: { used_percent: 28.4, limit_window_seconds: 604_800 },
+				},
+			}),
+		).toEqual({ remainingPercent: 72, windowLabel: "weekly" });
+	});
+
+	test("ignores malformed and non-weekly Codex usage windows", () => {
+		expect(
+			parseCodexUsage({
+				rate_limit: { primary_window: { used_percent: 20, limit_window_seconds: 18_000 } },
+			}),
+		).toBeUndefined();
+		expect(
+			parseCodexUsage({
+				rate_limit: { primary_window: { used_percent: "nope", limit_window_seconds: 604_800 } },
+			}),
+		).toBeUndefined();
+	});
+
+	test("parses Z.AI remaining percentage and actual window", () => {
+		expect(
+			parseZaiUsage({
+				data: { limits: [{ type: "TOKENS_LIMIT", unit: 3, number: 5, remainingPercentage: 71.6 }] },
+			}),
+		).toEqual({ remainingPercent: 72, windowLabel: "5h" });
+	});
+
+	test("derives and clamps Z.AI remaining percentage from consumed percentage", () => {
+		expect(
+			parseZaiUsage({
+				data: { limits: [{ type: "TOKENS_LIMIT", unit: "day", number: 7, percentage: 101 }] },
+			}),
+		).toEqual({ remainingPercent: 0, windowLabel: "7d" });
+	});
+
+	test("recognizes Z.AI's weekly quota encoding", () => {
+		expect(
+			parseZaiUsage({
+				data: { limits: [{ type: "TOKENS_LIMIT", unit: 6, number: 1, percentage: 28 }] },
+			}),
+		).toEqual({ remainingPercent: 72, windowLabel: "weekly" });
+	});
+});
+
+describe("ProviderUsageTracker", () => {
+	test("isolates cached values by provider and clears unsupported providers", () => {
+		const statuses: Array<string | undefined> = [];
+		const tracker = new ProviderUsageTracker({
+			getApiKey: async () => undefined,
+			onStatus: (text) => statuses.push(text),
+		});
+		tracker.selectProvider("openai-codex");
+		tracker.handleResponse("openai-codex", {
+			"x-codex-secondary-used-percent": "28",
+			"x-codex-secondary-window-minutes": "10080",
+		});
+		tracker.selectProvider("zai");
+		tracker.selectProvider("anthropic");
+		expect(statuses).toEqual([undefined, "(72% weekly)", undefined, undefined]);
+	});
+
+	test("refreshes Codex usage after a settled-provider refresh", async () => {
+		const statuses: Array<string | undefined> = [];
+		const fetchFn = vi.fn().mockResolvedValue({
+			ok: true,
+			json: async () => ({
+				rate_limit: { primary_window: { used_percent: 13, limit_window_seconds: 604_800 } },
+			}),
+		});
+		const tracker = new ProviderUsageTracker({
+			fetchFn,
+			getApiKey: async () => "oauth-token",
+			onStatus: (text) => statuses.push(text),
+		});
+		tracker.selectProvider("openai-codex");
+		await tracker.refreshSelectedProvider();
+		expect(statuses).toEqual([undefined, "(87% weekly)"]);
+		expect(fetchFn).toHaveBeenCalledWith(
+			"https://chatgpt.com/backend-api/wham/usage",
+			expect.objectContaining({ headers: { Authorization: "Bearer oauth-token" } }),
+		);
+	});
+
+	test("preserves valid Codex status after a usage endpoint failure", async () => {
+		const statuses: Array<string | undefined> = [];
+		const tracker = new ProviderUsageTracker({
+			fetchFn: vi.fn().mockRejectedValue(new Error("offline")),
+			getApiKey: async () => "oauth-token",
+			onStatus: (text) => statuses.push(text),
+		});
+		tracker.selectProvider("openai-codex");
+		tracker.handleResponse("openai-codex", {
+			"x-codex-secondary-used-percent": "28",
+			"x-codex-secondary-window-minutes": "10080",
+		});
+		await tracker.refreshSelectedProvider();
+		expect(statuses).toEqual([undefined, "(72% weekly)"]);
+	});
+
+	test("refreshes Z.AI and preserves valid status after transient failure", async () => {
+		const statuses: Array<string | undefined> = [];
+		const fetchFn = vi
+			.fn()
+			.mockResolvedValueOnce({
+				ok: true,
+				json: async () => ({
+					data: { limits: [{ type: "TOKENS_LIMIT", unit: 3, number: 5, percentage: 28 }] },
+				}),
+			})
+			.mockRejectedValueOnce(new Error("offline"));
+		const tracker = new ProviderUsageTracker({
+			fetchFn,
+			getApiKey: async () => "secret",
+			onStatus: (text) => statuses.push(text),
+		});
+		tracker.selectProvider("zai");
+		await tracker.refreshSelectedProvider();
+		await tracker.refreshSelectedProvider();
+		expect(statuses).toEqual([undefined, "(72% 5h)"]);
+		expect(fetchFn).toHaveBeenCalledWith(
+			"https://api.z.ai/api/monitor/usage/quota/limit",
+			expect.objectContaining({ headers: { Authorization: "Bearer secret" } }),
+		);
+	});
+
+	test("deduplicates concurrent Z.AI refreshes", async () => {
+		let resolveFetch!: (value: { ok: boolean; json(): Promise<unknown> }) => void;
+		const fetchFn = vi.fn(
+			() =>
+				new Promise<{ ok: boolean; json(): Promise<unknown> }>((resolve) => {
+					resolveFetch = resolve;
+				}),
+		);
+		const tracker = new ProviderUsageTracker({ fetchFn, getApiKey: async () => "secret", onStatus: () => {} });
+		tracker.selectProvider("zai-coding-cn");
+		const first = tracker.refreshSelectedProvider();
+		const second = tracker.refreshSelectedProvider();
+		await Promise.resolve();
+		resolveFetch({ ok: true, json: async () => ({ data: { limits: [] } }) });
+		await Promise.all([first, second]);
+		expect(first).toBe(second);
+		expect(fetchFn).toHaveBeenCalledTimes(1);
+		expect(fetchFn).toHaveBeenCalledWith("https://open.bigmodel.cn/api/monitor/usage/quota/limit", expect.anything());
+	});
+
+	test("publishes usage through the built-in footer status key", () => {
+		const setStatus = vi.fn();
+		const requestRender = vi.fn();
+		applyProviderUsageStatus("(72% weekly)", setStatus, requestRender);
+		expect(setStatus).toHaveBeenCalledWith("bangboo-provider-usage", "(72% weekly)");
+		expect(requestRender).toHaveBeenCalledTimes(1);
+	});
+});
