+/** Mirrors the interactive editor's /compact boundary: the exact command or the
+ * command followed by a space and optional instructions. Returns undefined for
+ * every other text so near-misses like /compact-foo stay ordinary prompts. */
+function parseCompactCommand(text: string): { instructions?: string } | undefined {
+	if (text === "/compact") return {};
+	if (text.startsWith("/compact ")) {
+		const instructions = text.slice("/compact ".length).trim();
+		return instructions ? { instructions } : {};
+	}
+	return undefined;
+}
+
+function compactionSummaryMessage(result: { summary: string; tokensBefore: number }): string {
+	return `**Compacted from ${result.tokensBefore.toLocaleString()} tokens**\n\n${result.summary}`;
+}
