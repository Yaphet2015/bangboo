new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/src/core/acp-mcp-servers.ts
@@ -0,0 +1,99 @@
+import { Type } from "typebox";
+import { Check } from "typebox/value";
+import { getAgentDir } from "../config.ts";
+import { loadMcpConfig } from "../extensions/mcp/config.ts";
+import type { InlineExtension } from "./extensions/types.ts";
+import { type McpServerConfig, mcpNamespace, validateMcpServerConfig } from "./mcp-servers.ts";
+
+const namedValueSchema = Type.Object({
+	name: Type.String({ minLength: 1 }),
+	value: Type.String(),
+});
+const acpMcpServerSchema = Type.Union([
+	Type.Object({
+		name: Type.String({ minLength: 1 }),
+		type: Type.Optional(Type.Literal("stdio")),
+		command: Type.String({ minLength: 1 }),
+		args: Type.Array(Type.String()),
+		env: Type.Array(namedValueSchema),
+	}),
+	Type.Object({
+		name: Type.String({ minLength: 1 }),
+		type: Type.Literal("http"),
+		url: Type.String(),
+		headers: Type.Array(namedValueSchema),
+	}),
+]);
+
+/** ACP values are already resolved. Escape config references to preserve them in the transport. */
+function mapLiteralValues(values: readonly { name: string; value: string }[]): Record<string, string> {
+	return Object.fromEntries(
+		values.map(({ name, value }) => {
+			const escaped = value.replaceAll("$", () => "$$");
+			return [name, escaped.startsWith("!") ? `$${escaped}` : escaped];
+		}),
+	);
+}
+
+export function mapAcpMcpServer(raw: unknown): { name: string; config: McpServerConfig } | string {
+	if (!Check(acpMcpServerSchema, raw)) return "Invalid ACP MCP server: expected a stdio or HTTP server";
+	const config: McpServerConfig =
+		raw.type === "http"
+			? {
+					type: "http",
+					url: raw.url,
+					headers: mapLiteralValues(raw.headers),
+				}
+			: {
+					type: "stdio",
+					command: raw.command,
+					args: [...raw.args],
+					env: mapLiteralValues(raw.env),
+				};
+	const validated = validateMcpServerConfig(raw.name, config);
+	return typeof validated === "string" ? validated : { name: raw.name, config: validated };
+}
+
+/** Registers trusted ACP client entries for this runtime only, after local extensions have loaded. */
+export function createAcpMcpServersExtension(servers: readonly unknown[]): InlineExtension {
+	return {
+		name: "acp-mcp-servers",
+		factory: (pi) => {
+			const registered = new Set<string>();
+			pi.on("session_start", (_event, ctx) => {
+				const configured = loadMcpConfig({
+					agentDir: getAgentDir(),
+					cwd: ctx.cwd,
+					projectTrusted: ctx.isProjectTrusted(),
+				});
+				for (const raw of servers) {
+					const mapped = mapAcpMcpServer(raw);
+					if (typeof mapped === "string") {
+						console.warn(`[ACP] ${mapped}`);
+						continue;
+					}
+					const { name, config } = mapped;
+					if (registered.has(name)) continue;
+					const namespace = mcpNamespace(name);
+					const local = [...configured.servers, ...pi.getMcpServers()].find(
+						(server) => mcpNamespace(server.name) === namespace,
+					);
+					if (local) {
+						console.warn(
+							`[ACP] Skipping client MCP server "${name}": local server "${local.name}" takes precedence`,
+						);
+						continue;
+					}
+					try {
+						pi.registerMcpServer(name, config);
+						registered.add(name);
+					} catch (error) {
+						console.warn(
+							`[ACP] Could not register client MCP server "${name}": ${error instanceof Error ? error.message : String(error)}`,
+						);
+					}
+				}
+			});
+		},
+	};
+}
