diff --git a/packages/coding-agent/test/acp/mcp-servers.test.ts b/packages/coding-agent/test/acp/mcp-servers.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/coding-agent/test/acp/mcp-servers.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from "vitest";
+import { mapAcpMcpServer } from "../../src/core/acp-mcp-servers.ts";
+import { resolveConfigValueOrThrow } from "../../src/core/resolve-config-value.ts";
+
+describe("ACP MCP server mapping", () => {
+	// biome-ignore lint/suspicious/noTemplateCurlyInString: ACP sends literal values, including config-like text.
+	it.each(["session-1", "${LODY_MCP_SESSION_ID}", "$VARIABLE", "!exit 1", "$$", "", "value$!tail"])(
+		"preserves resolved stdio environment and HTTP header values: %j",
+		(value) => {
+			const stdio = mapAcpMcpServer({
+				name: "lody",
+				command: "/usr/bin/node",
+				args: ["--server"],
+				env: [{ name: "LODY_MCP_SESSION_ID", value }],
+			});
+			if (typeof stdio === "string" || !("command" in stdio.config)) throw new Error("Expected stdio config");
+			expect(stdio.config.command).toBe("/usr/bin/node");
+			expect(stdio.config.args).toEqual(["--server"]);
+			expect(resolveConfigValueOrThrow(stdio.config.env!.LODY_MCP_SESSION_ID, "test env")).toBe(value);
+			const http = mapAcpMcpServer({
+				type: "http",
+				name: "lody",
+				url: "http://127.0.0.1/mcp",
+				headers: [{ name: "X-Lody-Session", value }],
+			});
+			if (typeof http === "string" || !("url" in http.config)) throw new Error("Expected HTTP config");
+			expect(http.config.url).toBe("http://127.0.0.1/mcp");
+			expect(resolveConfigValueOrThrow(http.config.headers!["X-Lody-Session"], "test header")).toBe(value);
+		},
+	);
+
+	it.each([
+		null,
+		{},
+		{ name: "bad name", command: "node", args: [], env: [] },
+		{ name: "lody", command: "", args: [], env: [] },
+		{ name: "lody", command: "node", args: [1], env: [] },
+		{ name: "lody", command: "node", args: [], env: [{ name: "KEY", value: 1 }] },
+		{ name: "lody", command: "node", args: [], env: {} },
+		{ type: "http", name: "lody", url: "file:///tmp/mcp", headers: [] },
+		{ type: "http", name: "lody", url: "http://127.0.0.1/mcp", headers: [{ name: "Header", value: true }] },
+		{ type: "sse", name: "lody", url: "http://127.0.0.1/mcp", headers: [] },
+		{ type: "acp", name: "lody", serverId: "server-1" },
+	])("rejects invalid or unsupported client MCP entries: %j", (raw) => {
+		expect(mapAcpMcpServer(raw)).toEqual(expect.any(String));
+	});
+});
